<UserControl x:Class="KryptoSmenarna.Wpf.UserSubWindows.TransactionHistorySubWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border Background="White" CornerRadius="12" Padding="24" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="2" Opacity="0.06"/>
        </Border.Effect>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Transakční historie" FontSize="20" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,12"/>
            <TextBlock Text="Zatím není implementováno." FontSize="14" Foreground="#6B7280"/>
        </StackPanel>
    </Border>
</UserControl>
