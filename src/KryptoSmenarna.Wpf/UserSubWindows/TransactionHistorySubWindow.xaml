<UserControl x:Class="KryptoSmenarna.Wpf.UserSubWindows.TransactionHistorySubWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Border Background="White" CornerRadius="12" Padding="24" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="2" Opacity="0.06"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Transakční historie" FontSize="20" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock x:Name="TextBlockHistoryRange" Text="Transakce za posledních 30 dní" FontSize="13" Foreground="#6B7280" Margin="0,4,0,0"/>
                </StackPanel>

                <UniformGrid Grid.Column="1" Columns="4" VerticalAlignment="Top" Margin="16,0,0,0">
                    <Button x:Name="ButtonHistoryDay" Content="D" Width="42" Height="30" Margin="0,0,6,0" Click="ButtonHistoryDay_Click"/>
                    <Button x:Name="ButtonHistoryWeek" Content="7D" Width="42" Height="30" Margin="0,0,6,0" Click="ButtonHistoryWeek_Click"/>
                    <Button x:Name="ButtonHistoryMonth" Content="1M" Width="42" Height="30" Margin="0,0,6,0" Click="ButtonHistoryMonth_Click"/>
                    <Button x:Name="ButtonHistoryYear" Content="1R" Width="42" Height="30" Click="ButtonHistoryYear_Click"/>
                </UniformGrid>
            </Grid>

            <Grid Grid.Row="1">
                <ListBox x:Name="ListBoxTransactionHistory" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,10" HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding MainText}" FontSize="14" FontWeight="SemiBold" Foreground="#111827"/>
                                        <TextBlock Text="{Binding DetailText}" FontSize="12" Foreground="#6B7280" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding EventTime, StringFormat={}{0:dd.MM.yyyy HH:mm}}" FontSize="12" Foreground="#9CA3AF" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" Foreground="#059669" Margin="16,0,0,0" VerticalAlignment="Top"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="TextBlockEmptyHistory"
                           Text="Žádné transakce za vybrané období."
                           FontSize="14"
                           Foreground="#6B7280"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
